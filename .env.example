# OpenAI API Key for image processing
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (defaults to SQLite with WAL mode enabled automatically)
DATABASE_URL=sqlite+aiosqlite:///./highlight_helper.db

# Backup rotation (number of backups to keep)
# KEEP_BACKUPS=7

# Environment
ENVIRONMENT=development

# Upload retention (eval corpus building)
# Persist every uploaded page photo + a JSON sidecar under UPLOADED_IMAGES_DIR
# so each becomes a near-ready eval case. Default ON (single-user internal
# deployment); set to false for a multi-user/production rollout.
# STORE_UPLOADED_IMAGES=true
# UPLOADED_IMAGES_DIR=data/uploads

# ---------------------------------------------------------------------------
# LLM gateway routing (optional, opt-in)
# ---------------------------------------------------------------------------
# Env-flip contract:
#   - Set BOTH vars -> all litellm calls in app/services/llm.py are routed
#     through the gateway at LLM_GATEWAY_BASE_URL using LLM_GATEWAY_API_KEY,
#     enabling per-project spend attribution.
#   - Leave BOTH unset -> calls go directly to the provider with no change to
#     existing behavior (provider keys below are used as-is).
# Only the main chat/coaching path (app/services/llm.py) is affected; model
# ids (e.g. openai/gpt-5.4, anthropic/claude-opus-4-6) are unchanged.
# From inside the docker compose container the host gateway is reachable at
# http://host.docker.internal:18400/v1 (extra_hosts is already configured).
# LLM_GATEWAY_BASE_URL=http://host.docker.internal:18400/v1
# LLM_GATEWAY_API_KEY=GATEWAY_KEY_PLACEHOLDER
